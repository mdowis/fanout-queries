{
  "manifest_version": 3,
  "name": "Fanout Queries",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "See what the AI actually searched. Captures chatbot fan-out queries, prompts, and cited sources — live, in a cyberpunk side panel.",
  "permissions": ["sidePanel", "storage", "alarms", "downloads", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://www.google.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Fanout Queries",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://www.google.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://www.google.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content/relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
